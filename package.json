{
  "name": "market-raid",
  "version": "1.0.0",
  "description": "웹 기반 2~4인 협동 FPS - 시장 실내 맵 / 폭발물 해체 미션",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:static": "node scripts/build-static.mjs",
    "import:models": "node scripts/import-models.mjs",
    "test": "node --test tests/*.test.mjs",
    "swap:character": "node scripts/swap-character.mjs",
    "import:animations": "node scripts/import-animations.mjs",
    "audio:levels": "node scripts/audio-levels.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "three": "^0.170.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "gltf-validator": "^2.0.0-dev.3.10",
    "socket.io-client": "^4.8.3"
  }
}
